# .env.example - Copy this file to .env and fill in your values
# Used by docker-compose.yml

# General
ENV=local
TZ=Etc/UTC

# Telegram Bot (REQUIRED)
TELEGRAM_TOKEN=

# Telegram Admin User ID (Optional, for notifications)
TELEGRAM_ADMIN_ID=

# MongoDB Credentials (REQUIRED if using authentication)
MONGO_ROOT_USER=root # Example for local setup, change for production
MONGO_ROOT_PASSWORD=example # Example for local setup, change for production
MONGO_USER=app_user # Application user
MONGO_PASSWORD=app_password # Application password
MONGO_DB_NAME=xray_vpn_bot_docker

# YooKassa Credentials (REQUIRED for payments)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8080/payment/return # Adjust for your setup
# YOOKASSA_WEBHOOK_SECRET= # Optional: Secret for validating webhooks

# XUI Configuration (Optional overrides)
# XUI_API_TIMEOUT=15s

# MongoDB URI (If different from docker-compose default)
# MONGO_URI=mongodb://user:password@host:port

# Application Environment (e.g., local, development, production)
# ENV=local 